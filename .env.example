# Copier en .env et renseigner les valeurs. Le .env réel n'est jamais versionné.
#
#   cp .env.example .env
#
# En développement local, rien n'est obligatoire : docker-compose.yml fournit
# des valeurs de repli. En production, Ansible génère /opt/task-manager/.env
# avec un mot de passe aléatoire.

POSTGRES_DB=tasks
POSTGRES_USER=tasks
POSTGRES_PASSWORD=change-me

# Port d'écoute sur la machine hôte, à changer si le 80 est déjà pris.
HTTP_PORT=80

# Production uniquement : images publiées par la pipeline et tag à déployer.
#BACKEND_IMAGE=votre-compte/task-manager-backend
#FRONTEND_IMAGE=votre-compte/task-manager-frontend
#IMAGE_TAG=0000000000000000000000000000000000000000

# Mettre « tls » pour activer le renouvellement Let's Encrypt.
#COMPOSE_PROFILES=tls
