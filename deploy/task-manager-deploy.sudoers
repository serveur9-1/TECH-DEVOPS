# Installé dans /etc/sudoers.d/task-manager-deploy (root:root, mode 0440).
# Ansible le valide avec « visudo -cf » avant de le mettre en place.
#
# gha-runner ne reçoit aucun privilège administrateur général : il peut
# uniquement lancer ce script précis, détenu par root et non modifiable par
# lui. Il n'est volontairement PAS membre du groupe docker, qui équivaut à un
# accès root sur la machine.
gha-runner ALL=(root) NOPASSWD: /usr/local/sbin/task-manager-deploy
