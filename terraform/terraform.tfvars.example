# Copier en terraform.tfvars et adapter. Le fichier réel n'est pas versionné.
#
#   cp terraform.tfvars.example terraform.tfvars

project_name = "task-manager"
aws_region   = "eu-west-3"

# Votre IP publique en /32 : curl -s https://ifconfig.me
ssh_allowed_cidrs = ["89.80.49.237/32"]

ssh_public_key_path = "~/.ssh/id_ed25519.pub"
